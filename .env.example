# =============================================================
# FleetOps — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env
# =============================================================

# Fuso horário (obrigatório para todos os containers)
TZ=America/Sao_Paulo

# =============================================================
# PostgreSQL
# =============================================================
DATABASE_URL=postgresql://fleetops:fleetops@localhost:5432/fleetops
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=fleetops

# =============================================================
# API (NestJS)
# =============================================================
API_PORT=3001
JWT_SECRET=substitua_por_um_secret_muito_seguro_em_producao
JWT_EXPIRATION=7d

# =============================================================
# Web (Next.js)
# =============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================
# Mobile (Expo)
# Android Emulator: http://10.0.2.2:3001
# iOS Simulator: http://localhost:3001
# Dispositivo físico: http://<IP_DA_MAQUINA>:3001
# =============================================================
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
