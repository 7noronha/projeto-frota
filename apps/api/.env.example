TZ=America/Sao_Paulo

# Conexão do banco (runtime + migrations).
#  - Local (docker-compose): Postgres local.
#  - Produção (Supabase): Session pooler, porta 5432 (host *.pooler.supabase.com).
DATABASE_URL=postgresql://fleetops:fleetops@localhost:5432/fleetops

JWT_SECRET=substitua_por_um_secret_muito_seguro_em_producao
JWT_EXPIRATION=7d

# Local usa API_PORT. Railway/Render/Fly injetam PORT automaticamente
# (main.ts: API_PORT -> PORT -> 3001) — não setar PORT manualmente lá.
API_PORT=3001

# Domínio do frontend para CORS. Em produção: a URL do projeto na Vercel
# (ex.: https://fleetops.vercel.app). Aceita credenciais (cookies).
CORS_ORIGIN=http://localhost:3000

# Token do Mapbox para geocoding server-side (endereço -> lat/lng).
# Usado ao criar/atualizar viagem para resolver origem (sede) e destino.
# Sem o token, a viagem é criada normalmente, apenas sem coordenadas
# (o mapa no detalhe simplesmente não é exibido).
# Crie um token gratuito em https://account.mapbox.com/access-tokens/.
MAPBOX_TOKEN=
