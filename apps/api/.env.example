TZ=America/Sao_Paulo

# Local (docker-compose). Em produção use a connection string do Supabase
# (conexão DIRETA, porta 5432 — a API é long-running, não serverless).
DATABASE_URL=postgresql://fleetops:fleetops@localhost:5432/fleetops

JWT_SECRET=substitua_por_um_secret_muito_seguro_em_producao
JWT_EXPIRATION=7d

# Local usa API_PORT. Railway/Render/Fly injetam PORT automaticamente
# (main.ts: API_PORT -> PORT -> 3001) — não setar PORT manualmente lá.
API_PORT=3001

# Domínio do frontend para CORS. Em produção: a URL do projeto na Vercel
# (ex.: https://fleetops.vercel.app). Aceita credenciais (cookies).
CORS_ORIGIN=http://localhost:3000
