{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fleetops/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@fleetops/utils": ["../../packages/utils/dist/index.d.ts"],
      "@fleetops/utils/datetime": ["../../packages/utils/dist/datetime.d.ts"],
      "@fleetops/types": ["../../packages/types/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
