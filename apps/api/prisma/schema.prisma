generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations usam conexão direta (Supabase: Session pooler 5432).
  // Local: aponte DIRECT_URL para o mesmo Postgres do docker-compose.
  directUrl = env("DIRECT_URL")
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model Usuario {
  id              String    @id @default(uuid())
  matricula       String    @unique @db.VarChar(10)
  nome            String    @db.VarChar(200)
  senhaHash       String    @map("senha_hash") @db.VarChar(255)
  perfil          String    @db.VarChar(20)
  email           String?   @db.VarChar(200)
  telefone        String?   @db.VarChar(20)
  cnh             String?   @db.VarChar(20)
  cnhValidade     DateTime? @map("cnh_validade") @db.Date
  ativo           Boolean   @default(true)

  dataCriacao     DateTime  @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime  @updatedAt @map("data_atualizacao") @db.Timestamp(6)
  dataExclusao    DateTime? @map("data_exclusao") @db.Timestamp(6)

  viagensComoMotorista Viagem[] @relation("MotoristaViagens")
  viagensCriadas       Viagem[] @relation("OperadorCriadorViagens")

  @@index([perfil], map: "idx_usuarios_perfil")
  @@map("usuarios")
}

// ─── Veículos ─────────────────────────────────────────────────────────────────

model Veiculo {
  id              String    @id @default(uuid())
  placa           String    @unique @db.VarChar(10)
  marca           String    @db.VarChar(80)
  modelo          String    @db.VarChar(100)
  anoFabricacao   Int       @map("ano_fabricacao")
  anoModelo       Int       @map("ano_modelo")
  cor             String    @db.VarChar(50)
  renavam         String    @unique @db.VarChar(11)
  odometroAtual   Int       @map("odometro_atual")
  dataAquisicao   DateTime  @map("data_aquisicao") @db.Date
  situacao        String    @db.VarChar(20)
  observacoes     String?   @db.Text

  dataCriacao     DateTime  @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime  @updatedAt @map("data_atualizacao") @db.Timestamp(6)
  dataExclusao    DateTime? @map("data_exclusao") @db.Timestamp(6)

  viagens         Viagem[]
  despesas        DespesaVeiculo[]

  @@index([placa], map: "idx_veiculos_placa")
  @@map("veiculos")
}

// ─── Despesas de Veículo ──────────────────────────────────────────────────────

model DespesaVeiculo {
  id              String   @id @default(uuid())
  veiculoId       String   @map("veiculo_id")

  // 'multa' | 'abastecimento' | 'manutencao'
  tipo            String   @db.VarChar(20)
  data            DateTime @db.Date
  valor           Decimal  @db.Decimal(10, 2)
  descricao       String   @db.VarChar(500)
  observacoes     String?  @db.Text

  // Odômetro do veículo no momento da despesa (útil em abastecimentos/manutenção)
  odometro        Int?

  // ─── Específicos de abastecimento ───────────────────────────────────────────
  litros          Decimal? @db.Decimal(8, 3)
  precoLitro      Decimal? @map("preco_litro") @db.Decimal(8, 3)
  // 'gasolina' | 'etanol' | 'diesel' | 'gnv' | 'flex'
  tipoCombustivel String?  @map("tipo_combustivel") @db.VarChar(20)

  // ─── Específicos de manutenção ──────────────────────────────────────────────
  // 'preventiva' | 'corretiva'
  tipoManutencao  String?  @map("tipo_manutencao") @db.VarChar(20)
  oficina         String?  @db.VarChar(200)

  // ─── Específicos de multa ───────────────────────────────────────────────────
  numeroAuto      String?  @map("numero_auto") @db.VarChar(50)
  // 'leve' | 'media' | 'grave' | 'gravissima'
  gravidade       String?  @db.VarChar(20)
  pontosCnh       Int?     @map("pontos_cnh")
  // Também usada por imposto, documentação (qualquer despesa com prazo)
  dataVencimento  DateTime? @map("data_vencimento") @db.Date

  // ─── Específicos de imposto ─────────────────────────────────────────────────
  // 'ipva' | 'licenciamento' | 'dpvat' | 'outro'
  tipoImposto     String?  @map("tipo_imposto") @db.VarChar(30)
  anoExercicio    Int?     @map("ano_exercicio")
  numeroParcela   Int?     @map("numero_parcela")
  totalParcelas   Int?     @map("total_parcelas")

  // ─── Específicos de seguro ──────────────────────────────────────────────────
  seguradora      String?  @db.VarChar(200)
  numeroApolice   String?  @map("numero_apolice") @db.VarChar(100)
  vigenciaInicio  DateTime? @map("vigencia_inicio") @db.Date
  vigenciaFim     DateTime? @map("vigencia_fim") @db.Date
  // 'total' | 'terceiros' | 'compreensiva'
  coberturaTipo   String?  @map("cobertura_tipo") @db.VarChar(30)

  // ─── Específicos de documentação ────────────────────────────────────────────
  // 'crlv' | 'transferencia' | 'vistoria' | 'emplacamento' | 'outro'
  tipoDocumento   String?  @map("tipo_documento") @db.VarChar(30)

  dataCriacao     DateTime  @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime  @updatedAt @map("data_atualizacao") @db.Timestamp(6)
  dataExclusao    DateTime? @map("data_exclusao") @db.Timestamp(6)

  veiculo         Veiculo  @relation(fields: [veiculoId], references: [id])

  @@index([veiculoId, tipo], map: "idx_despesas_veiculo_tipo")
  @@index([data], map: "idx_despesas_data")
  @@index([vigenciaFim], map: "idx_despesas_vigencia_fim")
  @@index([dataVencimento], map: "idx_despesas_data_vencimento")
  @@map("despesas_veiculos")
}

// ─── Viagens ──────────────────────────────────────────────────────────────────

model Viagem {
  id                  String    @id @default(uuid())
  origem              String    @db.VarChar(500)
  destino             String    @db.VarChar(500)
  dataViagem          DateTime  @map("data_viagem") @db.Date
  horaInicioPrevista  DateTime  @map("hora_inicio_prevista") @db.Time(0)
  horaFimPrevista     DateTime  @map("hora_fim_prevista") @db.Time(0)
  dataHoraInicioReal  DateTime? @map("data_hora_inicio_real") @db.Timestamp(6)
  dataHoraFimReal     DateTime? @map("data_hora_fim_real") @db.Timestamp(6)
  odometroInicial     Int?      @map("odometro_inicial")
  odometroFinal       Int?      @map("odometro_final")
  distanciaPercorrida Int?      @map("distancia_percorrida")
  motoristaId         String    @map("motorista_id")
  veiculoId           String    @map("veiculo_id")
  operadorCriadorId   String    @map("operador_criador_id")
  solicitadoPor       String    @map("solicitado_por") @db.VarChar(200)
  autorizadoPor       String    @map("autorizado_por") @db.VarChar(200)
  observacoes         String?   @db.Text
  status              String    @db.VarChar(20)

  dataCriacao     DateTime  @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime  @updatedAt @map("data_atualizacao") @db.Timestamp(6)
  dataExclusao    DateTime? @map("data_exclusao") @db.Timestamp(6)

  motorista       Usuario   @relation("MotoristaViagens", fields: [motoristaId], references: [id])
  operadorCriador Usuario   @relation("OperadorCriadorViagens", fields: [operadorCriadorId], references: [id])
  veiculo         Veiculo   @relation(fields: [veiculoId], references: [id])

  @@index([motoristaId, status], map: "idx_viagens_motorista_status")
  @@index([veiculoId, status], map: "idx_viagens_veiculo_status")
  @@index([dataViagem], map: "idx_viagens_data")
  @@map("viagens")
}

// ─── Configurações do Sistema ─────────────────────────────────────────────────

model Configuracao {
  id              String   @id @default(uuid())
  chave           String   @unique @db.VarChar(100)
  valor           String   @db.Text
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  @@map("configuracoes")
}
