// ════════════════════════════════════════════════════════════════════════════
// FleetOps — Schema (snake_case, INT IDs, FK p/ tipos, soft delete via flag)
// ════════════════════════════════════════════════════════════════════════════
// Convenções:
//  - Models em snake_case plural (igual ao nome da tabela)
//  - IDs Int autoincrement
//  - Timestamps: data_hora_criacao, data_hora_atualizacao, data_hora_exclusao
//  - Categorização (tipo/status/situação/perfil) sempre via FK → tabela auxiliar
//  - Despesas extraídas em 6 tabelas (multas, abastecimentos, manutencoes,
//    impostos, seguros, documentacoes)
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tabelas auxiliares de tipo/status (lookup) ─────────────────────────────

model perfis_usuario {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(40)
  descricao String?    @db.VarChar(200)
  usuarios  usuarios[]
}

model situacoes_veiculo {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(40)
  descricao String?    @db.VarChar(200)
  veiculos  veiculos[]
}

model status_viagem {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(40)
  descricao String?    @db.VarChar(200)
  viagens   viagens[]
}

model tipos_combustivel {
  id             Int              @id @default(autoincrement())
  nome           String           @unique @db.VarChar(40)
  descricao      String?          @db.VarChar(200)
  abastecimentos abastecimentos[]
}

model tipos_manutencao {
  id          Int           @id @default(autoincrement())
  nome        String        @unique @db.VarChar(40)
  descricao   String?       @db.VarChar(200)
  manutencoes manutencoes[]
}

model gravidades_multa {
  id            Int      @id @default(autoincrement())
  nome          String   @unique @db.VarChar(40)
  descricao     String?  @db.VarChar(200)
  pontos_padrao Int      @default(0)
  multas        multas[]
}

model tipos_imposto {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(40)
  descricao String?    @db.VarChar(200)
  impostos  impostos[]
}

model tipos_cobertura_seguro {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(40)
  descricao String?   @db.VarChar(200)
  seguros   seguros[]
}

model tipos_documento_veiculo {
  id            Int             @id @default(autoincrement())
  nome          String          @unique @db.VarChar(40)
  descricao     String?         @db.VarChar(200)
  documentacoes documentacoes[]
}

// ─── Entidades principais ───────────────────────────────────────────────────

model usuarios {
  id                    Int       @id @default(autoincrement())
  matricula             String    @unique @db.VarChar(10)
  nome                  String    @db.VarChar(200)
  senha_hash            String    @db.VarChar(255)
  perfil_id             Int
  email                 String?   @db.VarChar(200)
  telefone              String?   @db.VarChar(20)
  cnh                   String?   @db.VarChar(20)
  cnh_validade          DateTime? @db.Date
  ativo                 Boolean   @default(true)
  expo_push_token       String?   @db.VarChar(200)
  data_hora_criacao     DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  perfil                  perfis_usuario @relation(fields: [perfil_id], references: [id])
  viagens_como_motorista  viagens[]      @relation("MotoristaViagens")
  viagens_criadas         viagens[]      @relation("OperadorCriadorViagens")

  @@index([perfil_id])
  @@index([cnh_validade])
}

model veiculos {
  id                    Int       @id @default(autoincrement())
  placa                 String    @unique @db.VarChar(10)
  marca                 String    @db.VarChar(80)
  modelo                String    @db.VarChar(100)
  ano_fabricacao        Int
  ano_modelo            Int
  cor                   String    @db.VarChar(50)
  renavam               String    @unique @db.VarChar(11)
  odometro_atual        Int
  data_aquisicao        DateTime  @db.Date
  situacao_id           Int
  observacoes           String?   @db.Text
  data_hora_criacao     DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  situacao       situacoes_veiculo @relation(fields: [situacao_id], references: [id])
  viagens        viagens[]
  multas         multas[]
  abastecimentos abastecimentos[]
  manutencoes    manutencoes[]
  impostos       impostos[]
  seguros        seguros[]
  documentacoes  documentacoes[]

  @@index([placa])
  @@index([situacao_id])
}

model viagens {
  id                       Int       @id @default(autoincrement())
  origem                   String    @db.VarChar(500)
  destino                  String    @db.VarChar(500)
  origem_latitude          Decimal?  @db.Decimal(10, 7)
  origem_longitude         Decimal?  @db.Decimal(10, 7)
  destino_latitude         Decimal?  @db.Decimal(10, 7)
  destino_longitude        Decimal?  @db.Decimal(10, 7)
  rota_geometria           Json?     @db.JsonB
  rota_distancia_km        Decimal?  @db.Decimal(10, 2)
  rota_duracao_min         Int?
  data_viagem              DateTime  @db.Date
  hora_inicio_prevista     DateTime  @db.Time(0)
  hora_fim_prevista        DateTime  @db.Time(0)
  data_hora_inicio_real    DateTime? @db.Timestamp(6)
  data_hora_fim_real       DateTime? @db.Timestamp(6)
  odometro_inicial         Int?
  odometro_final           Int?
  distancia_percorrida     Int?
  motorista_id             Int
  veiculo_id               Int
  operador_criador_id      Int
  solicitado_por           String    @db.VarChar(200)
  autorizado_por           String    @db.VarChar(200)
  observacoes              String?   @db.Text
  status_id                Int
  data_hora_criacao        DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao    DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao       DateTime? @db.Timestamp(6)

  motorista        usuarios          @relation("MotoristaViagens", fields: [motorista_id], references: [id])
  operador_criador usuarios          @relation("OperadorCriadorViagens", fields: [operador_criador_id], references: [id])
  veiculo          veiculos          @relation(fields: [veiculo_id], references: [id])
  status           status_viagem     @relation(fields: [status_id], references: [id])
  posicoes         posicoes_viagem[]

  @@index([motorista_id, status_id])
  @@index([veiculo_id, status_id])
  @@index([data_viagem])
  @@index([status_id, data_viagem])
}

model posicoes_viagem {
  id                Int      @id @default(autoincrement())
  viagem_id         Int
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  precisao_m        Decimal? @db.Decimal(8, 2)
  capturado_em      DateTime @db.Timestamp(6)
  data_hora_criacao DateTime @default(now()) @db.Timestamp(6)

  viagem viagens @relation(fields: [viagem_id], references: [id], onDelete: Cascade)

  @@index([viagem_id, capturado_em(sort: Desc)])
}

// ─── Despesas (uma tabela por subtipo) ──────────────────────────────────────

model multas {
  id                    Int       @id @default(autoincrement())
  veiculo_id            Int
  gravidade_multa_id    Int
  data                  DateTime  @db.Date
  valor                 Decimal   @db.Decimal(10, 2)
  descricao             String    @db.VarChar(500)
  numero_auto           String?   @db.VarChar(50)
  pontos_cnh            Int?
  data_vencimento       DateTime? @db.Date
  observacoes           String?   @db.Text
  data_hora_criacao     DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  veiculo   veiculos         @relation(fields: [veiculo_id], references: [id])
  gravidade gravidades_multa @relation(fields: [gravidade_multa_id], references: [id])

  @@index([veiculo_id, data])
  @@index([data_vencimento])
}

model abastecimentos {
  id                    Int      @id @default(autoincrement())
  veiculo_id            Int
  tipo_combustivel_id   Int
  data                  DateTime @db.Date
  valor                 Decimal  @db.Decimal(10, 2)
  descricao             String   @db.VarChar(500)
  litros                Decimal  @db.Decimal(8, 3)
  preco_litro           Decimal  @db.Decimal(8, 3)
  odometro              Int?
  observacoes           String?  @db.Text
  data_hora_criacao     DateTime @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  veiculo          veiculos          @relation(fields: [veiculo_id], references: [id])
  tipo_combustivel tipos_combustivel @relation(fields: [tipo_combustivel_id], references: [id])

  @@index([veiculo_id, data])
}

model manutencoes {
  id                    Int       @id @default(autoincrement())
  veiculo_id            Int
  tipo_manutencao_id    Int
  data                  DateTime  @db.Date
  valor                 Decimal   @db.Decimal(10, 2)
  descricao             String    @db.VarChar(500)
  oficina               String?   @db.VarChar(200)
  odometro              Int?
  observacoes           String?   @db.Text
  data_hora_criacao     DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  veiculo         veiculos         @relation(fields: [veiculo_id], references: [id])
  tipo_manutencao tipos_manutencao @relation(fields: [tipo_manutencao_id], references: [id])

  @@index([veiculo_id, data])
}

model impostos {
  id                    Int       @id @default(autoincrement())
  veiculo_id            Int
  tipo_imposto_id       Int
  data                  DateTime  @db.Date
  valor                 Decimal   @db.Decimal(10, 2)
  descricao             String    @db.VarChar(500)
  ano_exercicio         Int
  numero_parcela        Int?
  total_parcelas        Int?
  data_vencimento       DateTime? @db.Date
  observacoes           String?   @db.Text
  data_hora_criacao     DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao    DateTime? @db.Timestamp(6)

  veiculo      veiculos      @relation(fields: [veiculo_id], references: [id])
  tipo_imposto tipos_imposto @relation(fields: [tipo_imposto_id], references: [id])

  historicos impostos_historicos[]

  @@index([veiculo_id, data])
  @@index([data_vencimento])
  @@index([ano_exercicio])
}

model impostos_historicos {
  id                 Int      @id @default(autoincrement())
  imposto_id         Int
  campo              String   @db.VarChar(40)
  valor_anterior     String?  @db.Text
  valor_novo         String?  @db.Text
  alterado_por       Int?
  data_hora_alteracao DateTime @default(now()) @db.Timestamp(6)

  imposto impostos @relation(fields: [imposto_id], references: [id], onDelete: Cascade)

  @@index([imposto_id, data_hora_alteracao(sort: Desc)])
}

model seguros {
  id                          Int       @id @default(autoincrement())
  veiculo_id                  Int
  tipo_cobertura_seguro_id    Int
  data                        DateTime  @db.Date
  valor                       Decimal   @db.Decimal(10, 2)
  descricao                   String    @db.VarChar(500)
  seguradora                  String    @db.VarChar(200)
  numero_apolice              String?   @db.VarChar(100)
  vigencia_inicio             DateTime  @db.Date
  vigencia_fim                DateTime  @db.Date
  observacoes                 String?   @db.Text
  data_hora_criacao           DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao       DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao          DateTime? @db.Timestamp(6)

  veiculo          veiculos               @relation(fields: [veiculo_id], references: [id])
  tipo_cobertura   tipos_cobertura_seguro @relation(fields: [tipo_cobertura_seguro_id], references: [id])

  @@index([veiculo_id, vigencia_fim])
}

model documentacoes {
  id                          Int       @id @default(autoincrement())
  veiculo_id                  Int
  tipo_documento_veiculo_id   Int
  data                        DateTime  @db.Date
  valor                       Decimal   @db.Decimal(10, 2)
  descricao                   String    @db.VarChar(500)
  data_vencimento             DateTime? @db.Date
  observacoes                 String?   @db.Text
  data_hora_criacao           DateTime  @default(now()) @db.Timestamp(6)
  data_hora_atualizacao       DateTime  @updatedAt @db.Timestamp(6)
  data_hora_exclusao          DateTime? @db.Timestamp(6)

  veiculo        veiculos                 @relation(fields: [veiculo_id], references: [id])
  tipo_documento tipos_documento_veiculo  @relation(fields: [tipo_documento_veiculo_id], references: [id])

  @@index([veiculo_id, data])
  @@index([data_vencimento])
}

// ─── Configurações ──────────────────────────────────────────────────────────

model configuracoes {
  id                    Int      @id @default(autoincrement())
  chave                 String   @unique @db.VarChar(100)
  valor                 String   @db.Text
  data_hora_atualizacao DateTime @updatedAt @db.Timestamp(6)
}
