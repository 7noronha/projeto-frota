# URL da API — usada no servidor (Server Components, Server Actions).
# Produção (Vercel): a URL pública da API na Railway, ex.:
#   https://fleetops-api.up.railway.app
API_URL=http://localhost:3001

# URL da API — exposta ao navegador (Client Components).
# Produção: mesma URL pública da API (Railway). Setar no painel da Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Token público do Mapbox — usado pelo MapaSeletor (criar viagem) e MapaViagem
# (detalhe da viagem) para renderizar o mapa e fazer geocoding/autocomplete.
# Crie um token gratuito em https://account.mapbox.com/access-tokens/.
# Sem este token, o mapa exibe um placeholder amigável e o resto da UI
# continua funcionando normalmente.
NEXT_PUBLIC_MAPBOX_TOKEN=
