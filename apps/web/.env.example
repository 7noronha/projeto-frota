# URL da API — usada no servidor (Server Components, Server Actions).
# Produção (Vercel): a URL pública da API na Railway, ex.:
#   https://fleetops-api.up.railway.app
API_URL=http://localhost:3001

# URL da API — exposta ao navegador (Client Components).
# Produção: mesma URL pública da API (Railway). Setar no painel da Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Token público do Mapbox — usado pelo MapaViagem para renderizar os tiles
# do mapa no detalhe da viagem. Mesmo valor do MAPBOX_TOKEN no .env da API.
# Sem ele, o card de mapa mostra um placeholder amigável.
NEXT_PUBLIC_MAPBOX_TOKEN=
