# URL da API — usada no servidor (Server Components, Server Actions).
# Produção (Vercel): a URL pública da API na Railway, ex.:
#   https://fleetops-api.up.railway.app
API_URL=http://localhost:3001

# URL da API — exposta ao navegador (Client Components).
# Produção: mesma URL pública da API (Railway). Setar no painel da Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mapas: o detalhe da viagem usa MapLibre + tiles do OpenStreetMap (sem
# token). Nenhuma variável adicional é necessária para renderização.
