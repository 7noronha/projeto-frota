{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fleetops/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fleetops/types": [
        "../../packages/types/src/index.ts"
      ],
      "@fleetops/validation": [
        "../../packages/validation/src/index.ts"
      ]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
