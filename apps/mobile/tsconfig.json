{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fleetops/config/tsconfig/react-native.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fleetops/types": [
        "../../packages/types/src/index.ts"
      ],
      "@fleetops/validation": [
        "../../packages/validation/src/index.ts"
      ],
      "tailwind.config": [
        "./tailwind.config.js"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "components/ui/**"
  ]
}